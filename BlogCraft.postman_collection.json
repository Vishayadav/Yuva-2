{
  "info": {
    "_postman_id": "d1c6e0e8-4d23-4c1b-9d6b-blogcraft-week2",
    "name": "BlogCraft REST API",
    "description": "End-to-end local API checks. Run Register then Login; the Login test script stores the token automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "postSlug",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Taylor Reader\",\"email\":\"taylor@example.com\",\"password\":\"SecurePass123\"}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"taylor@example.com\",\"password\":\"SecurePass123\"}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create published post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) { pm.collectionVariables.set('postId', body.data.id); pm.collectionVariables.set('postSlug', body.data.slug); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"A Practical API Test\",\"excerpt\":\"Testing the BlogCraft API with Postman.\",\"content\":\"This article body is long enough to satisfy the validation rule and demonstrate a published post.\",\"status\":\"published\"}"
            },
            "url": "{{baseUrl}}/posts"
          }
        },
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts?page=1&limit=10"
          }
        },
        {
          "name": "Get post by slug",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts/{{postSlug}}"
          }
        },
        {
          "name": "List my posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/posts/mine"
          }
        },
        {
          "name": "Update post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"excerpt\":\"Updated through the Postman collection.\"}"
            },
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) pm.collectionVariables.set('commentId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"This comment was created from Postman.\"}"
            },
            "url": "{{baseUrl}}/posts/{{postId}}/comments"
          }
        },
        {
          "name": "List comments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts/{{postId}}/comments"
          }
        },
        {
          "name": "Update comment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"The comment has been edited.\"}"
            },
            "url": "{{baseUrl}}/comments/{{commentId}}"
          }
        },
        {
          "name": "Delete comment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/comments/{{commentId}}"
          }
        },
        {
          "name": "Delete post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        }
      ]
    }
  ]
}